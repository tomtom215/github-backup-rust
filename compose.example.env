# github-backup-rust — Docker Compose environment template.
#
# Copy this file to `.env` in the same directory as `docker-compose.yml`
# and fill in the values for the profiles you use. Docker Compose loads
# `.env` automatically.
#
#     cp compose.example.env .env
#     chmod 600 .env
#     $EDITOR .env
#     docker compose run --rm backup octocat --all
#
# Never commit your `.env` file — it contains secrets.  The repo's
# `.gitignore` already excludes it.

# ─────────────────────────────────────────────────────────────────────────
# Required for every profile
# ─────────────────────────────────────────────────────────────────────────

# GitHub personal access token.  Classic PATs (ghp_…) and fine-grained
# tokens (github_pat_…) both work.  For a complete backup including
# private repos, generate a token with the `repo` scope.  Run
# `docker compose run --rm backup --list-scopes octocat --org --all`
# to see exactly which scopes the current flag set needs.
GITHUB_TOKEN=ghp_replace_me

# ─────────────────────────────────────────────────────────────────────────
# Optional: GitHub Enterprise Server
# ─────────────────────────────────────────────────────────────────────────

# Override the API base URL for GitHub Enterprise Server.
# Leave unset for github.com.
# GITHUB_API_URL=https://github.example.com/api/v3

# Override the git clone hostname for split API / clone GHES deployments.
# GITHUB_CLONE_HOST=github-git.example.com

# ─────────────────────────────────────────────────────────────────────────
# Optional: OAuth device flow (if you do not want to store a token)
# ─────────────────────────────────────────────────────────────────────────

# OAuth App client ID created at https://github.com/settings/developers.
# When set, pass `--device-auth` and comment out GITHUB_TOKEN above (the two
# are mutually exclusive) to use the device flow.
# GITHUB_OAUTH_CLIENT_ID=Iv1.replace_me

# ─────────────────────────────────────────────────────────────────────────
# AWS S3 profile  (`--profile s3`)
# ─────────────────────────────────────────────────────────────────────────

AWS_ACCESS_KEY_ID=AKIA_replace_me
AWS_SECRET_ACCESS_KEY=replace_me
S3_BUCKET=my-github-backup-bucket
S3_REGION=us-east-1
# Optional key prefix inside the bucket; omit for bucket-root storage.
# S3_PREFIX=github-backup/

# ─────────────────────────────────────────────────────────────────────────
# Backblaze B2 profile  (`--profile b2`)
# ─────────────────────────────────────────────────────────────────────────

B2_KEY_ID=replace_me
B2_APP_KEY=replace_me
B2_BUCKET=my-b2-bucket
B2_REGION=us-west-004

# ─────────────────────────────────────────────────────────────────────────
# MinIO / S3-compatible profile  (`--profile minio`)
# ─────────────────────────────────────────────────────────────────────────
# There is no bundled server any more (the `minio/minio` image is no longer
# published on Docker Hub).  Point these at an S3-compatible server you run
# and create the bucket there first; the tool does not create buckets.

MINIO_ENDPOINT=http://minio.internal:9000
MINIO_ROOT_USER=replace_me
MINIO_ROOT_PASSWORD=replace_me
MINIO_BUCKET=github-backup
# MINIO_REGION=us-east-1

# ─────────────────────────────────────────────────────────────────────────
# Codeberg / Forgejo / Gitea mirror profile  (`--profile codeberg`)
# ─────────────────────────────────────────────────────────────────────────
# Personal access token on the mirror target with repository write scope.

MIRROR_TOKEN=replace_me
MIRROR_URL=https://codeberg.org
MIRROR_OWNER=your-username-or-org

# ─────────────────────────────────────────────────────────────────────────
# GitLab mirror profile  (`--profile gitlab`)
# ─────────────────────────────────────────────────────────────────────────
# Personal access token on GitLab with `api`/`write_repository` scope.

GITLAB_TOKEN=replace_me
# Self-hosted: set to your instance URL.  Defaults to gitlab.com.
GITLAB_URL=https://gitlab.com
GITLAB_NAMESPACE=your-gitlab-username-or-group

# ─────────────────────────────────────────────────────────────────────────
# Optional at-rest encryption
# ─────────────────────────────────────────────────────────────────────────
# 32-byte hex-encoded key (64 hex chars) used for AES-256-GCM encryption
# before any S3 upload.  Generate with: `openssl rand -hex 32`
# Lose this key → lose the ability to decrypt your backups.

# BACKUP_ENCRYPT_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ─────────────────────────────────────────────────────────────────────────
# Optional webhook notification
# ─────────────────────────────────────────────────────────────────────────
# URL receiving a JSON POST with the backup outcome (success / failure).
# Failures here never affect the backup's exit code.

# BACKUP_NOTIFY_WEBHOOK=https://hooks.example.com/github-backup

# ─────────────────────────────────────────────────────────────────────────
# Optional: user, directory and umask  (Unraid / bind-mount ownership)
# ─────────────────────────────────────────────────────────────────────────
# Numeric uid:gid the container runs as; it must own BACKUP_DIR.  Defaults
# to 1000:1000.  Unraid shares are nobody:users, i.e. 99:100.
# BACKUP_UID=1000
# BACKUP_GID=1000
# Host directory mounted at /backup (default ./backups).
# BACKUP_DIR=./backups
# umask for files the backup writes (default 022; Unraid convention 000).
# UMASK=022
# Image tag (default latest).  Pin a minor series for unattended runs.
# GITHUB_BACKUP_TAG=0.3

# ─────────────────────────────────────────────────────────────────────────
# Optional non-interactive restore confirmation
# ─────────────────────────────────────────────────────────────────────────
# Set to `1` to authorise `--restore` without a TTY.  Equivalent to passing
# `--restore-yes` on the CLI; provided as an env var for CI / Compose runs.

# GITHUB_BACKUP_RESTORE_YES=1
